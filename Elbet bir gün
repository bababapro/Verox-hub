local function HoverEffect(btn, stroke, hoverBg, normalBg, hoverStroke, normalStroke)
	btn.MouseEnter:Connect(function()
		Tween(btn, 0.14, {BackgroundColor3 = hoverBg})
		if stroke and hoverStroke then
			Tween(stroke, 0.14, {Color = hoverStroke, Transparency = 0.05})
		end
	end)
	btn.MouseLeave:Connect(function()
		Tween(btn, 0.14, {BackgroundColor3 = normalBg})
		if stroke and normalStroke then
			Tween(stroke, 0.14, {Color = normalStroke, Transparency = 0.35})
		end
	end)
	btn.MouseButton1Down:Connect(function()
		Tween(btn, 0.08, {Size = UDim2.new(btn.Size.X.Scale, btn.Size.X.Offset, btn.Size.Y.Scale, btn.Size.Y.Offset - 2)})
	end)
	btn.MouseButton1Up:Connect(function()
		Tween(btn, 0.1, {Size = UDim2.new(btn.Size.X.Scale, btn.Size.X.Offset, btn.Size.Y.Scale, btn.Size.Y.Offset + 2)})
	end)
end

