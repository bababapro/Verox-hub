local function MakeInfoTile(yPos, labelTitle, valueText, clickable, copyVal)
	local tile = Instance.new("TextButton")
	tile.Size = UDim2.new(1, -24, 0, 44)
	tile.Position = UDim2.new(0, 12, 0, yPos)
	tile.BackgroundColor3 = C.Card
	tile.Text = ""
	tile.AutoButtonColor = false
	tile.BorderSizePixel = 0
	tile.Parent = Sidebar
	Round(tile, 8)
	local st = Stroke(tile, C.Border, 1, 0.35)

	local topLbl = Instance.new("TextLabel")
	topLbl.Size = UDim2.new(1, -36, 0, 14)
	topLbl.Position = UDim2.new(0, 30, 0, 6)
	topLbl.BackgroundTransparency = 1
	topLbl.Text = labelTitle
	topLbl.TextColor3 = C.Muted
	topLbl.Font = Enum.Font.GothamBold
	topLbl.TextSize = 9
	topLbl.TextXAlignment = Enum.TextXAlignment.Left
	topLbl.Parent = tile

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(1, -36, 0, 18)
	valLbl.Position = UDim2.new(0, 30, 0, 20)
	valLbl.BackgroundTransparency = 1
	valLbl.Text = valueText
	valLbl.TextColor3 = C.Text
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 11
	valLbl.TextXAlignment = Enum.TextXAlignment.Left
	valLbl.TextTruncate = Enum.TextTruncate.AtEnd
	valLbl.Parent = tile

	tile.MouseEnter:Connect(function()
		Tween(tile, 0.14, {BackgroundColor3 = Color3.fromRGB(27, 42, 36)})
		Tween(st, 0.14, {Color = C.BorderBright, Transparency = 0.1})
	end)
	tile.MouseLeave:Connect(function()
		Tween(tile, 0.14, {BackgroundColor3 = C.Card})
		Tween(st, 0.14, {Color = C.Border, Transparency = 0.35})
	end)

	if clickable and copyVal then
		tile.MouseButton1Click:Connect(function()
			SafeCopy(tostring(copyVal))
			local old = valLbl.Text
			valLbl.Text = "COPIED!"
			valLbl.TextColor3 = C.Green
			task.delay(1.1, function()
				if valLbl then
					valLbl.Text = old
					valLbl.TextColor3 = C.Text
				end
			end)
		end)
	end

	return tile, valLbl
end

