local function GrantAccess(enteredKey)
	if Config.SaveKeyToFile then
		pcall(function()
			if writefile then
				writefile(Config.KeyFileName, enteredKey)
			end
		end)
	end

	SetStatus("Key verified!", "License active · Unlocking " .. Config.HubName .. "...", C.Green, "●  Access granted! Launching loader...")
	AuthStatusLbl.Text = "Authenticated · " .. Config.Version
	Tween(WaitStroke, 0.2, {Color = C.Green, Transparency = 0.1})

	task.delay(0.75, function()
		Tween(UIScale, 0.22, {Scale = 0.88})
		Tween(MainWindow, 0.22, {BackgroundTransparency = 1})
		task.wait(0.24)
		pcall(function()
			ScreenGui:Destroy()
		end)

		if Config.MainScriptUrl and Config.MainScriptUrl ~= "" then
			pcall(function()
				loadstring(game:HttpGet(Config.MainScriptUrl))()
			end)
		elseif type(Config.OnKeySuccess) == "function" then
			pcall(Config.OnKeySuccess)
		end
	end)
end

local function CheckKey(rawKey)
	local cleaned = tostring(rawKey or ""):gsub("^%s*(.-)%s*$", "%1")
	if cleaned == "" then
		SetStatus("Key required", "Please paste your " .. Config.HubName .. " license key first", C.Red, "●  Enter a valid key or click Get Key.")
		Tween(InputStroke, 0.14, {Color = C.Red, Transparency = 0.05})
		task.delay(0.9, function()
			Tween(InputStroke, 0.14, {Color = C.Border, Transparency = 0.3})
		end)
		return
	end

	SetStatus("Verifying key...", "Checking license server...", C.Amber, "●  Validating your " .. Config.HubName .. " license...")
	task.wait(0.25)

	if cleaned == Config.ValidKey then
		GrantAccess(cleaned)
	else
		SetStatus("Invalid key", "License check failed · Try again", C.Red, "●  Invalid key! Use Get Key to get the latest access link.")
		Tween(InputStroke, 0.14, {Color = C.Red, Transparency = 0.05})
		task.delay(1.1, function()
			Tween(InputStroke, 0.14, {Color = C.Border, Transparency = 0.3})
		end)
	end
end

