    -- Getirme kategorileri
    local function createBringSection(title, icon, values, getter)
        Tab2:Space()
        local sec = Tab2:Section({ Title = title, Box = true, BoxBorder = true, ConfigFlagKey = title, Icon = icon, Opened = true })
        local selected = {}
        sec:Dropdown({
            Title = "Seç",
            AllowNone = true,
            Multi = true,
            Value = {},
            Values = values,
            Callback = function(v) selected = v end
        })
        sec:Button({
            Title = "Getir",
            Desc = title .. " seçilenleri getir",
            Callback = function()
                if not selected or #selected == 0 then
                    result:Notify({ Title = "Getir", Content = "Hiç eşya seçilmedi.", Duration = 2, Icon = "warning" })
                    return
                end
                local char = Players.LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local items = workspace:FindFirstChild("Items")
                if not items then return end
                for _, item in ipairs(items:GetChildren()) do
                    for _, name in ipairs(selected) do
                        if item.Name:lower():find(name:lower()) then
                            if item:IsA("Model") then
                                pcall(function()
                                    item:PivotTo(hrp.CFrame * CFrame.new(0, 0, -5))
                                end)
                            end
                            break
                        end
                    end
                end
                result:Notify({ Title = "Getir", Content = #selected .. " tür eşya getirildi.", Duration = 2, Icon = "check" })
            end
        })
    end

