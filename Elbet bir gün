	ContentArea.Visible = not minimized
	if minimized then
		Tween(MainWindow, 0.2, {Size = UDim2.new(0, 760, 0, 38)})
	else
		Tween(MainWindow, 0.2, {Size = UDim2.new(0, 760, 0, 520)})
	end
end

MinBtn.MouseButton1Click:Connect(ToggleMinimize)
YellowDot.MouseButton1Click:Connect(ToggleMinimize)

CloseBtn.MouseButton1Click:Connect(function()
	Tween(UIScale, 0.18, {Scale = 0.88})
	Tween(MainWindow, 0.18, {BackgroundTransparency = 1})
	task.wait(0.2)
	pcall(function()
		ScreenGui:Destroy()
	end)
end)

RedDot.MouseButton1Click:Connect(function()
	CloseBtn.MouseButton1Click:Fire()
end)

GreenDot.MouseButton1Click:Connect(function()
	ToggleMinimize()
end)

-- ==================== ENTRANCE ANIMATION & TIMER ====================
task.spawn(function()
	local targetScale = MainWindow:GetAttribute("BaseScale") or 1
	Tween(MainWindow, 0.28, {BackgroundTransparency = 0})
	Tween(UIScale, 0.3, {Scale = targetScale}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end)

-- Auto-load saved key if enabled
if Config.SaveKeyToFile then
	pcall(function()
		if isfile and readfile and isfile(Config.KeyFileName) then
			local saved = tostring(readfile(Config.KeyFileName)):gsub("^%s*(.-)%s*$", "%1")
			if saved ~= "" then
				KeyTextBox.Text = saved
			end
		end
	end)
end

-- Session MM:SS counter
local sessionStart = os.clock()
task.spawn(function()
	while task.wait(0.5) do
		if not ScreenGui or not ScreenGui.Parent then
			break
		end
		local sec = math.floor(os.clock() - sessionStart)
		local mins = math.floor(sec / 60)
		local remSec = sec % 60
		TimerLbl.Text = string.format("%02d:%02d", mins, remSec)
	end
end)
