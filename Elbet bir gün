		end
	end)
	pcall(function()
		thumb = Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
	end)
	local gameIcon = "rbxassetid://7072718362"
	pcall(function()
		-- Fallback icon
		gameIcon = "rbxasset://textures/ui/GuiImagePlaceholder.png"
	end)
	return gameName, thumb, gameIcon
end

