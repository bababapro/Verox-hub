local function SetStatus(mainText, subText, dotColor, hintText)
	WaitTitle.Text = mainText
	WaitSub.Text = subText
	Tween(WaitDot, 0.15, {BackgroundColor3 = dotColor})
	if hintText then
		FooterHint.Text = hintText
	end
