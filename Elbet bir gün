-- Responsive scaling for smaller screens
local function UpdateScale()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	local sx = (vp.X - 24) / 760
	local sy = (vp.Y - 24) / 520
	local targetBase = math.clamp(math.min(sx, sy, 1), 0.55, 1)
	MainWindow:SetAttribute("BaseScale", targetBase)
	UIScale.Scale = targetBase
end
