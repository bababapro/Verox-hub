-- AVATAR TAB
-- ============================================================
local AvatarTab = Window:Tab({ Title = "Avatar", Icon = "user", Desc = "Avatar değiştir" })

local AvatarSection = AvatarTab:Section({ Title = "Avatar Change", Icon = "user" })

local avatarInput = AvatarSection:Input({
    Title = "Username",
    Desc = "Avatarını değiştirmek istediğin oyuncunun adı",
    Icon = "user",
    Placeholder = "Username",
    Value = "",
    Callback = function(value) end,
})

AvatarSection:Button({
    Title = "Apply Avatar",
    Desc = "Avatarı uygula",
    Icon = "check",
    Callback = function()
        local username = avatarInput.Value
        if username == "" then
            Window:Notify({ Title = "Hata", Content = "Kullanıcı adı boş olamaz", Icon = "x", Duration = 3 })
            return
        end
        local rigsFolder = workspace:FindFirstChild("Rigs")
        local visualRig = rigsFolder and rigsFolder:FindFirstChild(LocalPlayer.Name)
        local humanoid = visualRig and visualRig:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            Window:Notify({ Title = "Hata", Content = "Visual rig bulunamadı", Icon = "x", Duration = 3 })
            return
        end
        local okUser, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
        if not okUser then
            Window:Notify({ Title = "Hata", Content = "Kullanıcı bulunamadı", Icon = "x", Duration = 3 })
            return
        end
        local okDesc, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
        if not okDesc then
            Window:Notify({ Title = "Hata", Content = "Avatar yüklenemedi", Icon = "x", Duration = 3 })
            return
        end
        local okApply = pcall(function() humanoid:ApplyDescriptionReset(desc) end)
        if okApply then
            Window:Notify({ Title = "Başarılı", Content = username .. " avatarı uygulandı", Icon = "check", Duration = 3 })
        else
            Window:Notify({ Title = "Hata", Content = "Avatar uygulanamadı", Icon = "x", Duration = 3 })
        end
    end,
})

